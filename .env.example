# Copy to .env (git-ignored) and fill in. The loader also accepts the bare
# lowercase `hf` key, which is what this repository's .env already uses.

# Hugging Face write token: https://huggingface.co/settings/tokens
# Needs the "repo.write" permission on your namespace.
hf=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: push under an organization instead of the token's own account.
# HF_NAMESPACE=my-org

# Optional: dataset location, if the release does not live in ./data/raw
# TOOTHFAIRY_DATA=E:/datasets/toothfairy4

# Optional: workspace root for caches and artifacts (defaults to the repo).
# CBCT_WORK_DIR=E:/cbct-work

# Optional: real RadFact evaluation.
#   provider "openai" with a key, or point base_url at a local Ollama / vLLM
#   server to keep patient reports off third-party APIs.
# OPENAI_API_KEY=sk-...
# RADFACT_MODEL=gpt-4o-mini
# RADFACT_BASE_URL=http://localhost:11434/v1

# Optional: Modal overrides.
# CBCT_VOLUME=cbct-toothfairy4
# CBCT_GPU=A10G
